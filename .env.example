# ============================================================
#  PandaDoc -> Discord contract notifications — settings
#  Fill these in on your host (Railway) under "Variables".
# ============================================================

# --- Discord: post as YOUR bot ---
# Bot token: https://discord.com/developers/applications
#   -> your app -> Bot -> Reset Token -> Copy
DISCORD_BOT_TOKEN=
# Channel ID: Discord -> Settings -> Advanced -> Developer Mode ON,
#   then right-click your channel -> Copy Channel ID
DISCORD_NOTIFY_CHANNEL_ID=
# Optional: a role to @mention on each alert (right-click role -> Copy Role ID)
DISCORD_NOTIFY_ROLE_ID=

# (Alternative to the bot: a channel Webhook URL. If this is set, it's used
#  INSTEAD of the bot. Leave blank to post as your bot.)
DISCORD_WEBHOOK_URL=

# --- PandaDoc ---
# API key: PandaDoc -> Settings -> API. Powers the "not signed yet" reminders.
PANDADOC_API_KEY=
# A password you invent. Put the SAME value in PandaDoc's webhook "Shared Key".
PANDADOC_WEBHOOK_SHARED_KEY=

# --- Timing ---
# How many hours a contract can sit unsigned before a follow-up reminder,
# and how often to check.
PANDADOC_REMINDER_HOURS=8
PANDADOC_POLL_INTERVAL_MINUTES=30
